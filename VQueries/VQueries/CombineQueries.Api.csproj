<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

    <!--
      PublishAot убран намеренно. Этот стек (MVC-контроллеры, EF Core, MediatR, Newtonsoft,
      Swashbuckle) целиком построен на рефлексии и деревьях выражений, а AOT выключает
      IsDynamicCodeSupported и CanEmitObjectArrayDelegate - отсюда и падение Swagger, и поломка
      миграций EF. Обратно включать только если переедешь на minimal API + source-gen JSON.
    -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dotseed.Context" Version="0.1.2" />
    <PackageReference Include="Dotseed.Domain" Version="0.1.1" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.AspNet.SignalR.Client" Version="2.4.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <!--
    PublishAot=true выключает "расширенные" метаданные модели, и Swashbuckle падает на
    NotSupportedException: IsConvertibleType is not initialized when IsEnhancedModelMetadataSupported is false.
    Возвращаем переключатель вручную - иначе Swagger не поднимается даже в дев-режиме.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Microsoft.AspNetCore.Mvc.ApiExplorer.IsEnhancedModelMetadataSupported" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VQueries.Domain\CombineQueries.Domain.csproj" />
    <ProjectReference Include="..\VQueries.Infra\CombineQueries.Infra.csproj" />
  </ItemGroup>
  
</Project>
