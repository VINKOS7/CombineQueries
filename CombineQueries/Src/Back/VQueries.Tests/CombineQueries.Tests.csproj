<Project Sdk="Microsoft.NET.Sdk">

  <!-- Проводные тесты: сервер для них чёрный ящик, ссылок на Api нет. Говорят те же печёные адреса,
       что и Udon-клиент, поэтому ловят и расхождение протокола, и поведение живого хоста. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>CombineQueries.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

</Project>
